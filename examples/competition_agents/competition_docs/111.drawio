                <mxCell id="aZ0WrSyEC6EXh-_T1yL0-81" value="Single-turn Metrics&lt;br&gt;&lt;br&gt;exact_match = true&lt;br&gt;memory_hits = 3&lt;br&gt;memory_hit_rate = 1.0&lt;br&gt;experience_hit_count = 1&lt;br&gt;experience_used_count = 1&lt;br&gt;latent_transfer_count = 3&lt;br&gt;text_chars = 2978" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f5f7;strokeColor=#777777;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=10;fontColor=#333333;fontFamily=Helvetica;" parent="1" vertex="1">
