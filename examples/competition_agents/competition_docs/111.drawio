                <mxCell id="aZ0WrSyEC6EXh-_T1yL0-83" value="Hypergraph Memory Retrieval" style="swimlane;html=1;startSize=36;rounded=0;whiteSpace=wrap;fillColor=#eff9f0;strokeColor=#6B766F;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#123d22;align=center;verticalAlign=middle;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="560" y="62" width="910" height="835" as="geometry"/>
                </mxCell>
                <mxCell id="aZ0WrSyEC6EXh-_T1yL0-84" value="Step 1. Actual Retrieval Query&lt;br&gt;&lt;br&gt;Question:&lt;br&gt;what mineral resources are found in this sea?&lt;br&gt;&lt;br&gt;Planner retrieval focus:&lt;br&gt;- Recall information about minerals present in the sea&lt;br&gt;- Identify specific mineral types&lt;br&gt;- Summarize mineral resources&lt;br&gt;&lt;br&gt;Experience family:&lt;br&gt;attribute_lookup_with_context" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#6B766F;strokeWidth=1.4;fontSize=13;align=left;verticalAlign=middle;spacing=10;fontFamily=Helvetica;" parent="aZ0WrSyEC6EXh-_T1yL0-83" vertex="1">
                    <mxGeometry x="15" y="48" width="255" height="182" as="geometry"/>
                </mxCell>
                <mxCell id="aZ0WrSyEC6EXh-_T1yL0-88" value="Step 2. Retrieval Order inside RetrieverAgent&lt;br&gt;&lt;br&gt;Call 1: Context hypergraph search&lt;br&gt;search_context(...) returns candidate context hits&lt;br&gt;&lt;br&gt;Then Retriever local rerank:&lt;br&gt;_rerank_hypergraph_hits(...)&lt;br&gt;+20 if text equals supporting_passage&lt;br&gt;+10 if kind=supporting_passage&lt;br&gt;+4 if title matches topic&lt;br&gt;+5 if section matches topic_section&lt;br&gt;&lt;br&gt;Call 2: Evidence memory search&lt;br&gt;Call 3: Experience memory search" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#6B766F,#967FD3);strokeWidth=1.4;fontSize=13;align=left;verticalAlign=middle;spacing=10;fontColor=#123d22;fontFamily=Helvetica;" parent="aZ0WrSyEC6EXh-_T1yL0-83" vertex="1">
                    <mxGeometry x="610" y="58" width="280" height="172" as="geometry"/>
                </mxCell>
                <mxCell id="aZ0WrSyEC6EXh-_T1yL0-85" value="Step 3a. Context Hypergraph Result&lt;br&gt;&lt;br&gt;Store searched:&lt;br&gt;task context hypergraph&lt;br&gt;&lt;br&gt;Top result:&lt;br&gt;North Sea / Mineral resources&lt;br&gt;context_score = 12.0&lt;br&gt;&lt;br&gt;Why it hits:&lt;br&gt;title/topic = North Sea; section = Mineral resources; keywords overlap with mineral/resources/found/sea&lt;br&gt;&lt;br&gt;Content:&lt;br&gt;sand, gravel, rolled pieces of amber" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E5F1E5;strokeColor=light-dark(#6B766F,#967FD3);strokeWidth=1.4;fontSize=13;align=left;verticalAlign=middle;spacing=10;fontFamily=Helvetica;" parent="aZ0WrSyEC6EXh-_T1yL0-83" vertex="1">
