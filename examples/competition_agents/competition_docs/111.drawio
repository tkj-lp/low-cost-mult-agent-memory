                <mxCell id="cn-aZ0WrSyEC6EXh-_T1yL0-85" value="步骤 3a：上下文超图检索&lt;br&gt;&lt;br&gt;检索位置：&lt;br&gt;任务上下文超图&lt;br&gt;&lt;br&gt;最高命中：&lt;br&gt;North Sea / Mineral resources&lt;br&gt;上下文得分 = 12.0&lt;br&gt;&lt;br&gt;为什么命中：&lt;br&gt;title/topic = North Sea；section = Mineral resources；关键词与 mineral/resources/found/sea 重合&lt;br&gt;&lt;br&gt;内容：&lt;br&gt;sand、gravel、rolled pieces of amber" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E5F1E5;strokeColor=light-dark(#6B766F,#967FD3);strokeWidth=1.4;fontSize=13;align=left;verticalAlign=middle;spacing=10;fontFamily=Helvetica;" parent="cn-aZ0WrSyEC6EXh-_T1yL0-83" vertex="1">
