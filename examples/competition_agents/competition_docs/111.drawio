                <mxCell id="aZ0WrSyEC6EXh-_T1yL0-74" value="Multi-Agent Framework with Hypergraph Memory Retrieval" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#111111;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1620" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="aZ0WrSyEC6EXh-_T1yL0-76" value="Current Task&lt;br&gt;&lt;br&gt;Actual task text:&lt;br&gt;Continuous HotpotQA-style task. Reuse prior memory in the same group when helpful.&lt;br&gt;&lt;br&gt;Question:&lt;br&gt;what mineral resources are found in this sea?&lt;br&gt;&lt;br&gt;Unresolved reference:&lt;br&gt;this sea = ?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEFDFF;strokeColor=#8DA3AE;strokeWidth=1.5;fontSize=14;align=left;verticalAlign=middle;spacing=12;fontColor=#3f2a00;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="150" y="62" width="280" height="158" as="geometry"/>
                </mxCell>
                <mxCell id="aZ0WrSyEC6EXh-_T1yL0-77" value="PlannerAgent&lt;br&gt;&lt;br&gt;Actual planner output:&lt;br&gt;1. Recall information about minerals present in the sea.&lt;br&gt;2. Identify specific types of minerals known to be abundant in that particular sea area.&lt;br&gt;3. Summarize details on the identified mineral resources.&lt;br&gt;&lt;br&gt;Output to Retriever:&lt;br&gt;question + planner focus" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#ecf2fe, #0c1d21);strokeColor=#8DA3AE;strokeWidth=1.8;fontSize=14;align=left;verticalAlign=middle;spacing=12;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="150" y="240" width="280" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="aZ0WrSyEC6EXh-_T1yL0-78" value="RetrieverAgent&lt;br&gt;&lt;br&gt;Internal retrieval calls in this turn:&lt;br&gt;1. context hypergraph search&lt;br&gt;2. evidence memory search&lt;br&gt;3. experience memory search&lt;br&gt;&lt;br&gt;Then combine results into one package:&lt;br&gt;context hit + mem-0012 + mem-0011 + mem-0010" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#F0F2FF,#18202C);strokeColor=#8DA3AE;strokeWidth=1.8;fontSize=14;align=left;verticalAlign=middle;spacing=12;fontColor=#102a56;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="150" y="430" width="280" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="aZ0WrSyEC6EXh-_T1yL0-79" value="ReasonerAgent&lt;br&gt;&lt;br&gt;Input package:&lt;br&gt;North Sea mineral passage + history evidence + experience rule&lt;br&gt;&lt;br&gt;Resolved reference:&lt;br&gt;this sea → North Sea&lt;br&gt;&lt;br&gt;Actual candidate:&lt;br&gt;sand and gravel, amber&lt;br&gt;&lt;br&gt;Rule used:&lt;br&gt;pick requested attribute only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EBEBFF;strokeColor=#8DA3AE;strokeWidth=1.8;fontSize=14;align=left;verticalAlign=middle;spacing=12;fontColor=#102a56;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="150" y="640" width="280" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="aZ0WrSyEC6EXh-_T1yL0-80" value="SummarizerAgent&lt;br&gt;&lt;br&gt;Actual final answer:&lt;br&gt;The mineral resources found in the North Sea include sand, gravel, and rolled pieces of amber.&lt;br&gt;&lt;br&gt;Experience distilled:&lt;br&gt;For attribute lookup with context, identify the requested attribute and extract only relevant entities.&lt;br&gt;&lt;br&gt;Write back:&lt;br&gt;evidence mem-0013 + experience mem-0010" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1EBFF;strokeColor=#8DA3AE;strokeWidth=1.8;fontSize=14;align=left;verticalAlign=middle;spacing=12;fontColor=#102a56;fontFamily=Helvetica;" parent="1" vertex="1">
