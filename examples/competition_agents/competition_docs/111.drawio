                <mxCell id="cn-aZ0WrSyEC6EXh-_T1yL0-83" value="超图记忆检索" style="swimlane;html=1;startSize=36;rounded=0;whiteSpace=wrap;fillColor=#eff9f0;strokeColor=#6B766F;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#123d22;align=center;verticalAlign=middle;fontFamily=Helvetica;" parent="cn-1" vertex="1">
                    <mxGeometry x="560" y="62" width="910" height="748" as="geometry"/>
                </mxCell>
                <mxCell id="cn-aZ0WrSyEC6EXh-_T1yL0-84" value="步骤 1：实际检索查询&lt;br&gt;&lt;br&gt;问题：&lt;br&gt;what mineral resources are found in this sea?&lt;br&gt;&lt;br&gt;Planner 检索焦点：&lt;br&gt;- 回忆该海域中的矿物信息&lt;br&gt;- 识别具体矿产类型&lt;br&gt;- 汇总矿产资源答案&lt;br&gt;&lt;br&gt;经验类型：&lt;br&gt;attribute_lookup_with_context" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#6B766F;strokeWidth=1.4;fontSize=13;align=left;verticalAlign=middle;spacing=10;fontFamily=Helvetica;" parent="cn-aZ0WrSyEC6EXh-_T1yL0-83" vertex="1">
                    <mxGeometry x="15" y="48" width="285" height="202" as="geometry"/>
                </mxCell>
                <mxCell id="cn-aZ0WrSyEC6EXh-_T1yL0-88" value="步骤 2：RetrieverAgent 内部检索顺序&lt;br&gt;&lt;br&gt;第 1 次：上下文超图检索&lt;br&gt;search_context(...) 返回候选上下文&lt;br&gt;&lt;br&gt;然后由 Retriever 本地重排：&lt;br&gt;_rerank_hypergraph_hits(...)&lt;br&gt;文本等于 supporting_passage：+20&lt;br&gt;类型为 supporting_passage：+10&lt;br&gt;title 匹配 topic：+4&lt;br&gt;section 匹配 topic_section：+5&lt;br&gt;&lt;br&gt;第 2 次：事实记忆检索&lt;br&gt;第 3 次：经验记忆检索" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F1F1;strokeColor=light-dark(#6B766F,#967FD3);strokeWidth=1.4;fontSize=13;align=left;verticalAlign=middle;spacing=10;fontColor=#123d22;fontFamily=Helvetica;glass=0;shadow=0;perimeterSpacing=0;" parent="cn-aZ0WrSyEC6EXh-_T1yL0-83" vertex="1">
