                <mxCell id="aZ0WrSyEC6EXh-_T1yL0-86" value="Step 3b. Evidence Memory Result&lt;br&gt;&lt;br&gt;Store searched:&lt;br&gt;shared evidence memory&lt;br&gt;&lt;br&gt;mem-0011｜score 88.0139&lt;br&gt;Answer: The local people fished in the North Sea.&lt;br&gt;&lt;br&gt;mem-0012｜score 89.7714&lt;br&gt;Answer: Commonly found fish in the North Sea include cod, haddock, ... sandeel.&lt;br&gt;&lt;br&gt;Role:&lt;br&gt;these hits support the reference resolution this sea → North Sea" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9E7E2;strokeColor=light-dark(#6B766F,#967FD3);strokeWidth=1.4;fontSize=13;align=left;verticalAlign=middle;spacing=10;fontColor=#123d22;fontFamily=Helvetica;" parent="aZ0WrSyEC6EXh-_T1yL0-83" vertex="1">
                    <mxGeometry x="315" y="278" width="280" height="212" as="geometry"/>
