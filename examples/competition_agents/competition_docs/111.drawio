                <mxCell id="cn-aZ0WrSyEC6EXh-_T1yL0-95" value="检索记忆" style="endArrow=block;html=1;rounded=0;strokeColor=#6B766F;strokeWidth=2;fontSize=12;fontColor=#123d22;verticalAlign=middle;fontFamily=Helvetica;" parent="cn-aZ0WrSyEC6EXh-_T1yL0-83" source="cn-aZ0WrSyEC6EXh-_T1yL0-78" target="cn-aZ0WrSyEC6EXh-_T1yL0-84" edge="1">
