    <diagram name="多智能体超图记忆检索框架" id="translated-cn-page-v2">
        <mxGraphModel dx="1653" dy="682" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="cn-0"/>
