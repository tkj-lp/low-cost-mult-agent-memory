                        </Array>
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="aZ0WrSyEC6EXh-_T1yL0-87" value="Step 3c. Experience Memory Result&lt;br&gt;&lt;br&gt;mem-0010｜score 98.6334&lt;br&gt;&lt;br&gt;Reusable experience:&lt;br&gt;When a question asks for an attribute of a context-dependent entity, first resolve the entity from history, then answer only the requested attribute.&lt;br&gt;&lt;br&gt;In this case:&lt;br&gt;resolve this sea → North Sea&lt;br&gt;requested attribute = mineral resources&lt;br&gt;keep = sand, gravel, rolled pieces of amber&lt;br&gt;avoid = fish/economy facts&lt;br&gt;&lt;br&gt;Internal tag: attribute_lookup_with_context" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DBE9EB;strokeColor=light-dark(#6B766F,#967FD3);strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=10;fontColor=#332061;fontFamily=Helvetica;" parent="aZ0WrSyEC6EXh-_T1yL0-83" vertex="1">
