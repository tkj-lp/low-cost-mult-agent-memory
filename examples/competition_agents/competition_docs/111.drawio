                <mxCell id="aZ0WrSyEC6EXh-_T1yL0-96" value="context search" style="endArrow=block;html=1;rounded=0;strokeColor=#6B766F;strokeWidth=1.8;fontSize=12;fontColor=#123d22;verticalAlign=middle;fontFamily=Helvetica;" parent="aZ0WrSyEC6EXh-_T1yL0-83" source="aZ0WrSyEC6EXh-_T1yL0-84" target="aZ0WrSyEC6EXh-_T1yL0-85" edge="1">
