                <mxCell id="cn-aZ0WrSyEC6EXh-_T1yL0-74" value="多智能体框架与超图记忆检索" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#111111;fontFamily=Helvetica;" parent="cn-1" vertex="1">
                    <mxGeometry x="-80" y="20" width="1550" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="cn-aZ0WrSyEC6EXh-_T1yL0-76" value="当前任务&lt;br&gt;&lt;br&gt;实际任务指令：&lt;br&gt;连续 HotpotQA 风格任务；需要时复用同一组内的历史记忆。&lt;br&gt;&lt;br&gt;问题：&lt;br&gt;what mineral resources are found in this sea?&lt;br&gt;&lt;br&gt;待解析指代：&lt;br&gt;this sea = ?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEFDFF;strokeColor=#8DA3AE;strokeWidth=1.5;fontSize=14;align=left;verticalAlign=middle;spacing=12;fontColor=#3f2a00;fontFamily=Helvetica;" parent="cn-1" vertex="1">
                    <mxGeometry x="30" y="62" width="400" height="178" as="geometry"/>
                </mxCell>
                <mxCell id="cn-aZ0WrSyEC6EXh-_T1yL0-77" value="规划智能体（PlannerAgent）&lt;br&gt;&lt;br&gt;实际规划输出：&lt;br&gt;1. 回忆该海域中存在的矿物信息。&lt;br&gt;2. 识别该海域常见或丰富的具体矿产类型。&lt;br&gt;3. 汇总已识别的矿产资源细节。&lt;br&gt;&lt;br&gt;发送给检索智能体：&lt;br&gt;问题 + 检索焦点" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#ecf2fe, #0c1d21);strokeColor=#8DA3AE;strokeWidth=1.8;fontSize=14;align=left;verticalAlign=middle;spacing=12;fontFamily=Helvetica;" parent="cn-1" vertex="1">
                    <mxGeometry x="30" y="250" width="400" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="cn-aZ0WrSyEC6EXh-_T1yL0-78" value="检索智能体（RetrieverAgent）&lt;br&gt;&lt;br&gt;本轮内部检索调用：&lt;br&gt;1. 上下文超图检索&lt;br&gt;2. 事实记忆检索&lt;br&gt;3. 经验记忆检索&lt;br&gt;&lt;br&gt;随后合并成一个检索包：&lt;br&gt;上下文命中 + mem-0012 + mem-0011 + mem-0010" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#F0F2FF,#18202C);strokeColor=#8DA3AE;strokeWidth=1.8;fontSize=14;align=left;verticalAlign=middle;spacing=12;fontColor=#102a56;fontFamily=Helvetica;" parent="cn-1" vertex="1">
                    <mxGeometry x="30" y="430" width="400" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="cn-aZ0WrSyEC6EXh-_T1yL0-79" value="推理智能体（ReasonerAgent）&lt;br&gt;&lt;br&gt;输入包：&lt;br&gt;North Sea 矿产段落 + 历史事实证据 + 经验规则&lt;br&gt;&lt;br&gt;指代解析：&lt;br&gt;this sea → North Sea&lt;br&gt;&lt;br&gt;实际候选答案：&lt;br&gt;sand and gravel, amber&lt;br&gt;&lt;br&gt;使用规则：&lt;br&gt;只抽取当前问题要求的属性" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EBEBFF;strokeColor=#8DA3AE;strokeWidth=1.8;fontSize=14;align=left;verticalAlign=middle;spacing=12;fontColor=#102a56;fontFamily=Helvetica;" parent="cn-1" vertex="1">
                    <mxGeometry x="30" y="620" width="400" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="cn-aZ0WrSyEC6EXh-_T1yL0-80" value="总结智能体（SummarizerAgent）&lt;br&gt;&lt;br&gt;实际最终答案：&lt;br&gt;North Sea 中发现的矿产资源包括 sand、gravel 和 rolled pieces of amber。&lt;br&gt;&lt;br&gt;总结出的经验：&lt;br&gt;遇到带上下文指代的属性查询，要先确认问题问的属性，再只抽取该属性对应的答案。&lt;br&gt;&lt;br&gt;写回：&lt;br&gt;事实 mem-0013 + 经验 mem-0010" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1EBFF;strokeColor=#8DA3AE;strokeWidth=1.8;fontSize=14;align=left;verticalAlign=middle;spacing=12;fontColor=#102a56;fontFamily=Helvetica;" parent="cn-1" vertex="1">
                    <mxGeometry x="30" y="870" width="400" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="cn-aZ0WrSyEC6EXh-_T1yL0-81" value="单题指标&lt;br&gt;&lt;br&gt;精确匹配 = true&lt;br&gt;记忆命中数 = 3&lt;br&gt;记忆命中率 = 1.0&lt;br&gt;经验命中数 = 1&lt;br&gt;经验使用数 = 1&lt;br&gt;隐状态传输次数 = 3&lt;br&gt;文本字符数 = 2978" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f5f7;strokeColor=#777777;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=10;fontColor=#333333;fontFamily=Helvetica;" parent="cn-1" vertex="1">
                    <mxGeometry x="740" y="930" width="160" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="cn-aZ0WrSyEC6EXh-_T1yL0-83" value="超图记忆检索" style="swimlane;html=1;startSize=36;rounded=0;whiteSpace=wrap;fillColor=#eff9f0;strokeColor=#6B766F;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#123d22;align=center;verticalAlign=middle;fontFamily=Helvetica;" parent="cn-1" vertex="1">
                    <mxGeometry x="560" y="62" width="910" height="748" as="geometry"/>
                </mxCell>
                <mxCell id="cn-aZ0WrSyEC6EXh-_T1yL0-84" value="步骤 1：实际检索查询&lt;br&gt;&lt;br&gt;问题：&lt;br&gt;what mineral resources are found in this sea?&lt;br&gt;&lt;br&gt;Planner 检索焦点：&lt;br&gt;- 回忆该海域中的矿物信息&lt;br&gt;- 识别具体矿产类型&lt;br&gt;- 汇总矿产资源答案&lt;br&gt;&lt;br&gt;经验类型：&lt;br&gt;attribute_lookup_with_context" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#6B766F;strokeWidth=1.4;fontSize=13;align=left;verticalAlign=middle;spacing=10;fontFamily=Helvetica;" parent="cn-aZ0WrSyEC6EXh-_T1yL0-83" vertex="1">
                    <mxGeometry x="15" y="48" width="285" height="232" as="geometry"/>
                </mxCell>
                <mxCell id="cn-aZ0WrSyEC6EXh-_T1yL0-88" value="步骤 2：RetrieverAgent 内部检索顺序&lt;br&gt;&lt;br&gt;第 1 次：上下文超图检索&lt;br&gt;search_context(...) 返回候选上下文&lt;br&gt;&lt;br&gt;然后由 Retriever 本地重排：&lt;br&gt;_rerank_hypergraph_hits(...)&lt;br&gt;文本等于 supporting_passage：+20&lt;br&gt;类型为 supporting_passage：+10&lt;br&gt;title 匹配 topic：+4&lt;br&gt;section 匹配 topic_section：+5&lt;br&gt;&lt;br&gt;第 2 次：事实记忆检索&lt;br&gt;第 3 次：经验记忆检索" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F1F1;strokeColor=light-dark(#6B766F,#967FD3);strokeWidth=1.4;fontSize=13;align=left;verticalAlign=middle;spacing=10;fontColor=#123d22;fontFamily=Helvetica;glass=0;shadow=0;perimeterSpacing=0;" parent="cn-aZ0WrSyEC6EXh-_T1yL0-83" vertex="1">
                    <mxGeometry x="550" y="48" width="340" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="cn-aZ0WrSyEC6EXh-_T1yL0-85" value="步骤 3a：上下文超图检索&lt;br&gt;&lt;br&gt;检索位置：&lt;br&gt;任务上下文超图&lt;br&gt;&lt;br&gt;最高命中：&lt;br&gt;North Sea / Mineral resources&lt;br&gt;上下文得分 = 12.0&lt;br&gt;&lt;br&gt;为什么命中：&lt;br&gt;title/topic = North Sea；section = Mineral resources；关键词与 mineral/resources/found/sea 重合&lt;br&gt;&lt;br&gt;内容：&lt;br&gt;sand、gravel、rolled pieces of amber" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E5F1E5;strokeColor=light-dark(#6B766F,#967FD3);strokeWidth=1.4;fontSize=13;align=left;verticalAlign=middle;spacing=10;fontFamily=Helvetica;" parent="cn-aZ0WrSyEC6EXh-_T1yL0-83" vertex="1">
                    <mxGeometry x="15" y="320" width="285" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="cn-aZ0WrSyEC6EXh-_T1yL0-96" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#6B766F;strokeWidth=1.8;fontSize=12;fontColor=#123d22;verticalAlign=middle;fontFamily=Helvetica;" parent="cn-aZ0WrSyEC6EXh-_T1yL0-83" source="cn-aZ0WrSyEC6EXh-_T1yL0-84" target="cn-aZ0WrSyEC6EXh-_T1yL0-85" edge="1">
